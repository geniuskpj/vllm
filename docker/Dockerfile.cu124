# syntax=docker/dockerfile:1.7

# ============================================================
# vLLM GLM-5.3 Flash / CUDA 12.4 / H100 test image
#
# Target:
#   CUDA       12.4.1
#   Python     3.12
#   PyTorch    2.6.0 + cu124
#   GPU        H100 / SM90
#   DeepEP     disabled
#   DeepGEMM   disabled
#   Triton     pip/package version, no source build
# ============================================================

ARG CUDA_VERSION=12.4.1
ARG PYTHON_VERSION=3.12
ARG UBUNTU_VERSION=22.04

# IMPORTANT:
# Keep the manylinux builder. The vLLM Dockerfile uses dnf and
# /opt/python/cp312-cp312 from this image.
ARG BUILD_BASE_IMAGE=pytorch/manylinux2_28-builder:cuda12.4-f406207af2bad07c294badef24c2f56680e74442

ARG FINAL_BASE_IMAGE=nvidia/cuda:${CUDA_VERSION}-base-ubuntu${UBUNTU_VERSION}

ARG PYTORCH_CUDA_INDEX_BASE_URL=https://download.pytorch.org/whl
ARG PIP_INDEX_URL=
ARG PIP_EXTRA_INDEX_URL=
ARG PYTHON_VERSION=3.12

# H100 only.
ARG TORCH_CUDA_ARCH_LIST=9.0

# Build parallelism.
ARG MAX_JOBS=4
ARG NVCC_THREADS=2

# ============================================================
# BASE
# ============================================================

FROM ${BUILD_BASE_IMAGE} AS base

ARG CUDA_VERSION
ARG PYTHON_VERSION
ARG TORCH_CUDA_ARCH_LIST

ENV UV_HTTP_TIMEOUT=500
ENV UV_INDEX_STRATEGY=unsafe-best-match
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python
ENV UV_CACHE_DIR=/opt/uv/cache
ENV UV_INSTALL_DIR=/opt/uv/bin
ENV PATH=/opt/venv/bin:/opt/uv/bin:${PATH}
ENV VIRTUAL_ENV=/opt/venv

ENV TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST}



# IUS EL7 repository is retired.
RUN find /etc/yum.repos.d -type f \
        -exec sed -i \
        '/^\[ius\]/,/^\[/ s/^enabled=.*/enabled=0/' {} \; \
    || true

RUN dnf remove -y \
        git236 \
        git236-core \
    || true


RUN dnf clean all \
    && dnf makecache --refresh

# CUDA 12.4 manylinux image uses dnf.
RUN dnf install -y --setopt=install_weak_deps=False \
        ccache \
        git \
        curl \
        sudo \
        rdma-core-devel \
        make \
        perl-core \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Install uv and create the build virtualenv from the manylinux Python.
RUN mkdir -p "${UV_PYTHON_INSTALL_DIR}" \
            "${UV_CACHE_DIR}" \
            "${UV_INSTALL_DIR}" \
    && chmod -R a+rX /opt/uv \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && PYV_NODOT=$(echo ${PYTHON_VERSION} | tr -d '.') \
    && MANYLINUX_PY=/opt/python/cp${PYV_NODOT}-cp${PYV_NODOT}/bin/python${PYTHON_VERSION} \
    && uv venv --seed /opt/venv --python "${MANYLINUX_PY}" \
    && rm -f /usr/bin/python3 /usr/bin/python3-config /usr/bin/pip \
    && ln -sf /opt/venv/bin/python3 /usr/bin/python3 \
    && ln -sf /opt/venv/bin/python3-config /usr/bin/python3-config \
    && ln -sf /opt/venv/bin/pip /usr/bin/pip \
    && python3 --version \
    && python3 -m pip --version

ENV UV_LINK_MODE=copy

RUN gcc --version \
    && nvcc --version

WORKDIR /workspace

# ============================================================
# PYTORCH + PYTHON DEPENDENCIES
# ============================================================

COPY requirements/common.txt requirements/common.txt
COPY requirements/cuda.txt requirements/cuda.txt
COPY use_existing_torch.py use_existing_torch.py
COPY pyproject.toml pyproject.toml

# CUDA 12 build substitutions.
#
# IMPORTANT:
# requirements/cuda.txt in your fork must contain a CUDA-12-compatible
# torch version. For your target that should be torch 2.6.0.
RUN sed -i \
        's/^nvidia-cutlass-dsl\[cu13\]/nvidia-cutlass-dsl/' \
        requirements/cuda.txt \
    && sed -i \
        's/^humming-kernels\[cu13\]/humming-kernels[cu12]/' \
        requirements/cuda.txt

# Install PyTorch + dependencies from CUDA 12.4 index.
RUN --mount=type=cache,target=/opt/uv/cache \
    uv pip install \
        --python /opt/venv/bin/python3 \
        -r requirements/cuda.txt \
        --extra-index-url \
        ${PYTORCH_CUDA_INDEX_BASE_URL}/cu124

# Verify the actual torch version/CUDA version before doing the
# expensive C++ build.
RUN python3 - <<'PY'
import torch

print("========================================")
print("PyTorch:", torch.__version__)
print("Torch CUDA:", torch.version.cuda)
print("CUDA available:", torch.cuda.is_available())

assert torch.__version__.startswith("2.6."), \
    f"Expected Torch 2.6.x, got {torch.__version__}"

assert torch.version.cuda == "12.4", \
    f"Expected CUDA 12.4, got {torch.version.cuda}"

print("Torch/CUDA check OK")
print("========================================")
PY

# ============================================================
# RUST BUILD
# ============================================================

FROM base AS rust-build

WORKDIR /workspace

COPY requirements/build/rust.txt requirements/build/rust.txt

RUN --mount=type=cache,target=/opt/uv/cache \
    uv pip install \
        --python /opt/venv/bin/python3 \
        -r requirements/build/rust.txt

COPY rust rust
COPY rust-toolchain.toml rust-toolchain.toml
COPY tools/build_rust.py tools/build_rust.py
COPY build_rust.sh build_rust.sh

ENV CARGO_BUILD_JOBS=4

RUN --mount=type=cache,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,target=/root/.cargo/git,sharing=locked \
    SETUPTOOLS_SCM_PRETEND_VERSION="0.0.0+docker" \
    bash build_rust.sh

# ============================================================
# CUDA/C++ BUILD
#
# DeepGEMM deliberately disabled.
# DeepEP deliberately disabled.
# ============================================================

FROM base AS csrc-build

ARG MAX_JOBS
ARG NVCC_THREADS

WORKDIR /workspace

COPY requirements/build/cuda.txt requirements/build/cuda.txt
COPY use_existing_torch.py use_existing_torch.py

RUN --mount=type=cache,target=/opt/uv/cache \
    uv pip install \
        --python /opt/venv/bin/python3 \
        -r requirements/build/cuda.txt \
        --extra-index-url \
        https://download.pytorch.org/whl/cu124

COPY pyproject.toml setup.py CMakeLists.txt ./
COPY tools/build_rust.py tools/build_rust.py
COPY cmake cmake/
COPY csrc csrc/
COPY vllm/envs.py vllm/envs.py
COPY vllm/__init__.py vllm/__init__.py

ENV MAX_JOBS=${MAX_JOBS}
ENV NVCC_THREADS=${NVCC_THREADS}

ENV VLLM_TARGET_DEVICE=cuda
ENV SETUPTOOLS_SCM_PRETEND_VERSION="0.0.0+csrc.build"

# Do NOT create the DeepGEMM Python matrix.
#
# The upstream Dockerfile does:
#
#   tools/setup_deepgemm_pythons.sh
#
# We intentionally skip that for the CUDA 12.4 test build.

RUN --mount=type=cache,target=/root/.cache/ccache \
    --mount=type=cache,target=/opt/uv/cache \
    rm -rf .deps \
    && mkdir -p .deps \
    && export VLLM_DOCKER_BUILD_CONTEXT=1 \
    && python3 setup.py bdist_wheel \
        --dist-dir=dist \
        --py-limited-api=cp38

# ============================================================
# FINAL WHEEL
# ============================================================

FROM base AS build

ARG MAX_JOBS
ARG NVCC_THREADS

WORKDIR /workspace

COPY requirements/build/cuda.txt requirements/build/cuda.txt
COPY use_existing_torch.py use_existing_torch.py

RUN --mount=type=cache,target=/opt/uv/cache \
    uv pip install \
        --python /opt/venv/bin/python3 \
        -r requirements/build/cuda.txt \
        --extra-index-url \
        https://download.pytorch.org/whl/cu124

COPY pyproject.toml setup.py CMakeLists.txt ./
COPY cmake cmake/
COPY csrc csrc/
COPY vllm vllm/
COPY tools tools/
COPY examples examples/
COPY benchmarks benchmarks/

COPY --from=csrc-build /workspace/dist /precompiled-wheels
COPY --from=rust-build /workspace/vllm/vllm-rs vllm/vllm-rs
COPY --from=rust-build /workspace/vllm/_rust_*.so vllm/

ENV MAX_JOBS=${MAX_JOBS}
ENV NVCC_THREADS=${NVCC_THREADS}

ENV VLLM_TARGET_DEVICE=cuda
ENV VLLM_SKIP_PRECOMPILED_VERSION_SUFFIX=1
ENV VLLM_DOCKER_BUILD_CONTEXT=1

RUN --mount=type=cache,target=/opt/uv/cache \
    export VLLM_USE_PRECOMPILED=1 \
    && export VLLM_PRECOMPILED_WHEEL_LOCATION=$(ls /precompiled-wheels/*.whl) \
    && python3 setup.py bdist_wheel \
        --dist-dir=dist \
        --py-limited-api=cp38

RUN sha256sum dist/*.whl > dist/wheel.sha256

# ============================================================
# RUNTIME BASE
# ============================================================

FROM ${FINAL_BASE_IMAGE} AS vllm-runtime-base

ARG CUDA_VERSION
ARG PYTHON_VERSION

ENV CUDA_VERSION=${CUDA_VERSION}
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /vllm-workspace

# ------------------------------------------------------------
# Python + system dependencies
# ------------------------------------------------------------

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        software-properties-common \
        curl \
        sudo \
        ffmpeg \
        libsm6 \
        libxext6 \
        libgl1 \
        libibverbs-dev \
        libnuma-dev \
        numactl \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python${PYTHON_VERSION} \
        python${PYTHON_VERSION}-dev \
        python${PYTHON_VERSION}-venv \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives \
        --install /usr/bin/python3 python3 \
        /usr/bin/python${PYTHON_VERSION} 1 \
    && update-alternatives \
        --set python3 /usr/bin/python${PYTHON_VERSION} \
    && ln -sf \
        /usr/bin/python${PYTHON_VERSION}-config \
        /usr/bin/python3-config \
    && rm -f \
        /usr/lib/python${PYTHON_VERSION}/EXTERNALLY-MANAGED \
    && curl -sS https://bootstrap.pypa.io/get-pip.py \
        | python${PYTHON_VERSION}

# ------------------------------------------------------------
# CUDA 12.4 development libraries
#
# Needed by FlashInfer runtime JIT compilation.
# ------------------------------------------------------------

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        --allow-change-held-packages \
        cuda-nvcc-12-4 \
        cuda-cudart-12-4 \
        cuda-nvrtc-12-4 \
        cuda-nvrtc-dev-12-4 \
        cuda-cuobjdump-12-4 \
        libcurand-dev-12-4 \
        libcublas-dev-12-4 \
    && rm -rf /var/lib/apt/lists/*

ENV CUDA_HOME=/usr/local/cuda
ENV PATH=/usr/local/cuda/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

# ------------------------------------------------------------
# uv
# ------------------------------------------------------------

RUN python3 -m pip install uv

ENV UV_HTTP_TIMEOUT=500
ENV UV_INDEX_STRATEGY=unsafe-best-match
ENV UV_LINK_MODE=copy
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python
ENV UV_CACHE_DIR=/opt/uv/cache

RUN mkdir -p \
        "${UV_PYTHON_INSTALL_DIR}" \
        "${UV_CACHE_DIR}" \
    && chmod -R a+rX /opt/uv

# ------------------------------------------------------------
# CUDA forward compatibility
#
# H100 + R550 is expected to be able to run CUDA 12.4 directly.
# Keep this OFF for the initial test.
# ------------------------------------------------------------

ENV VLLM_ENABLE_CUDA_COMPATIBILITY=0

# ============================================================
# PYTORCH + RUNTIME DEPENDENCIES
# ============================================================

COPY requirements/common.txt /tmp/common.txt
COPY requirements/cuda.txt /tmp/requirements-cuda.txt

RUN sed -i \
        's/^nvidia-cutlass-dsl\[cu13\]/nvidia-cutlass-dsl/' \
        /tmp/requirements-cuda.txt \
    && sed -i \
        's/^humming-kernels\[cu13\]/humming-kernels[cu12]/' \
        /tmp/requirements-cuda.txt

RUN --mount=type=cache,target=/opt/uv/cache \
    uv pip install \
        --system \
        -r /tmp/requirements-cuda.txt \
        --extra-index-url \
        https://download.pytorch.org/whl/cu124 \
    && rm -f \
        /tmp/common.txt \
        /tmp/requirements-cuda.txt

# Verify runtime Torch.
RUN python3 - <<'PY'
import torch

print("========================================")
print("Runtime PyTorch:", torch.__version__)
print("Runtime Torch CUDA:", torch.version.cuda)

assert torch.__version__.startswith("2.6."), \
    f"Expected Torch 2.6.x, got {torch.__version__}"

assert torch.version.cuda == "12.4", \
    f"Expected CUDA 12.4, got {torch.version.cuda}"

print("Runtime Torch/CUDA check OK")
print("========================================")
PY

# ============================================================
# FLASHINFER
#
# Use only if 0.6.18.post1 has a cu124 JIT cache.
# If this fails, comment this block out and build FlashInfer
# from source separately.
# ============================================================

ARG FLASHINFER_VERSION=0.6.18.post1

RUN --mount=type=cache,target=/opt/uv/cache \
    uv pip install \
        --system \
        flashinfer-jit-cache==${FLASHINFER_VERSION} \
        --index-url \
        https://flashinfer.ai/whl/cu124

# ============================================================
# OPENAI SERVER DEPENDENCIES
# ============================================================

RUN --mount=type=cache,target=/opt/uv/cache \
    uv pip install \
        --system \
        accelerate \
        'modelscope<1.38' \
        'timm>=1.0.17' \
        'runai-model-streamer[s3,gcs,azure]>=0.15.7'

# ============================================================
# vLLM INSTALLATION
# ============================================================

FROM vllm-runtime-base AS vllm-base

COPY --from=build /workspace/dist/wheel.sha256 \
    /tmp/vllm-wheel.sha256

RUN --mount=type=bind,from=build,source=/workspace/dist,target=/vllm-workspace/dist \
    --mount=type=cache,target=/opt/uv/cache \
    uv pip install \
        --system \
        dist/*.whl \
        --extra-index-url \
        https://download.pytorch.org/whl/cu124

ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib64:/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

# ============================================================
# OpenAI server
# ============================================================

FROM vllm-base AS vllm-openai

COPY examples examples
COPY benchmarks benchmarks
COPY vllm/collect_env.py .

ENV VLLM_USAGE_SOURCE=production-docker-image

ENTRYPOINT ["vllm", "serve"]
